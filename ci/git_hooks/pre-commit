#!/usr/bin/env bash
# Refuse commits whose author or committer identity drifts from this repository's recent history.
set -euo pipefail

repo=$(git rev-parse --show-toplevel)
policy="$repo/ci/commit-identity"
if [ -f "$policy" ]; then
  expected_name=$(sed -n 's/^name=//p' "$policy" | head -n 1)
  expected_email=$(sed -n 's/^email=//p' "$policy" | head -n 1)
else
  # NOTE: the `|| true` must stay OUTSIDE the command substitution. Placed
  # inside the pipeline (`git ... || true | awk`) it short-circuits on success
  # and awk never runs, so baseline becomes the raw multi-line log and every
  # repo with mixed identities in its last 20 commits gets blocked (that
  # regression shipped in 40f8148; fixed here). Outside, the pipeline stays
  # intact on success and pipefail failures (empty repos) are absorbed.
  baseline=$(git -C "$repo" log -20 --format='%an%x09%ae' 2>/dev/null | awk -F '\t' '
    NF >= 2 { count[$0]++; if (count[$0] > max) { max = count[$0]; winner = $0 } }
    END { print winner }
  ') || true
  [ -n "$baseline" ] || exit 0
  expected_name=${baseline%%$'\t'*}
  expected_email=${baseline#*$'\t'}
fi
[ -n "$expected_name" ] && [ -n "$expected_email" ] || {
  echo "pre-commit: incomplete identity policy in $policy" >&2
  exit 1
}
parse_identity() {
  local ident="$1"
  local name="${ident%% <*}"
  local email="${ident#*<}"
  email="${email%%>*}"
  printf '%s\t%s\n' "$name" "$email"
}

for role in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  ident=$(git var "$role")
  parsed=$(parse_identity "$ident")
  actual_name=${parsed%%$'\t'*}
  actual_email=${parsed#*$'\t'}
  if [ "$actual_name" != "$expected_name" ] || [ "$actual_email" != "$expected_email" ]; then
    printf '%s\n' \
      "pre-commit: identity mismatch ($role)" \
      "  repository: $repo" \
      "  expected from recent history: $expected_name <$expected_email>" \
      "  actual: $actual_name <$actual_email>" \
      "  inspect git log and the repository remote before changing identity." >&2
    exit 1
  fi
done

toolkit_pin_gate="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/verify_consumer_toolkit_pin.sh"
if [ -f "$toolkit_pin_gate" ]; then
  bash "$toolkit_pin_gate" "$repo"
fi

pointer_gate="${MAGISK_POINTER_GATE:-/root/play/magisk-ci-toolkit/ci/git_hooks/pointer_gate.py}"
if [ -f "$pointer_gate" ]; then
  python3 "$pointer_gate" --mode pre-commit --repo "$repo"
fi

# --- recently-modified-but-unstaged warning (H7, 2026-11-23) ----------------
# The fleet's "forgot to stage a file" incident: an edited .gitlab-ci.yml was
# left out of a commit and only surfaced after the push (costing an amend).
# Files touched within the window that are NOT part of this commit get a
# warning -- never a block, because shared dirty trees legitimately carry
# other people's unstaged work.
STAGE_WINDOW_MINUTES="${MAGISK_STAGE_WINDOW_MINUTES:-15}"
cutoff=$(( $(date +%s) - STAGE_WINDOW_MINUTES * 60 ))
recent_unstaged=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  [ -e "$f" ] || continue
  mtime=$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null || echo 0)
  if [ "$mtime" -ge "$cutoff" ]; then
    recent_unstaged="$recent_unstaged $f"
  fi
done <<INPUT
$(git diff --name-only; git ls-files --others --exclude-standard)
INPUT
if [ -n "$recent_unstaged" ]; then
  echo "pre-commit: 注意 -- 以下文件在最近 ${STAGE_WINDOW_MINUTES} 分钟内被修改但未进入本次提交:" >&2
  for f in $recent_unstaged; do
    echo "  $f" >&2
  done
  echo "  若是本笔改动的一部分，请 git add 后重新提交；若是他人 WIP 可忽略。" >&2
fi
