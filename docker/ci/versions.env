# Single source of truth for the magisk-ci-toolkit CI image version matrix.
# Sourced by .gitlab/ci/docker.yml; every value is passed to docker build as a
# build-arg (the Dockerfile defaults are for standalone manual builds only).
# Image tags are derived from these upstream versions — bump here, rebuild, done.

# utility target: base tag. The published version tags are the *full* Alpine
# release (e.g. 3.24.2), read from /etc/alpine-release at build time, plus
# this minor tag.
MAGISK_CI_ALPINE_VERSION=3.24

# utility target: GitHub CLI release.
MAGISK_CI_GH_VERSION=2.63.2

# android-jdk target: temurin base tag and the short version used in image tags.
MAGISK_CI_TEMURIN_TAG=27_35-jdk-resolute
MAGISK_CI_TEMURIN_VERSION=27_35

# zygisk-rust target: rust base tag and the short version used in image tags.
MAGISK_CI_RUST_TAG=1.99.1-trixie
MAGISK_CI_RUST_VERSION=1.99.1

# webui-bun target: bun base tag and the short version used in image tags.
MAGISK_CI_BUN_TAG=1.4.4-alpine
MAGISK_CI_BUN_VERSION=1.4.4
